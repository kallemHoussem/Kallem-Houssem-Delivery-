rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'ay3afsa@gmail.com';
    }
    function isCourier() {
      return signedIn()
        && exists(/databases/$(database)/documents/couriers/$(request.auth.uid))
        && get(/databases/$(database)/documents/couriers/$(request.auth.uid)).data.status == 'approved';
    }

    match /orders/{orderId} {
      // Existing checkout supports guest orders. Guest orders may be created but never read or edited by guests.
      allow create: if request.resource.data.keys().hasOnly([
        'kind', 'nom', 'adr', 'text', 'total', 'status', 'tel', 'maps', 'ts', 'uid'
      ])
      && request.resource.data.status == 'new'
      && request.resource.data.nom is string
      && request.resource.data.adr is string
      && request.resource.data.text is string
      && request.resource.data.text.size() <= 2500
      && request.resource.data.total is number
      && (!('uid' in request.resource.data) ||
          (signedIn() && request.resource.data.uid == request.auth.uid));

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (isCourier() && resource.data.courierUid == request.auth.uid);

      allow update: if isAdmin()
        || (isCourier()
            && resource.data.courierUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'done');
      allow delete: if isAdmin();
    }

    match /couriers/{courierId} {
      allow create: if signedIn()
        && request.auth.uid == courierId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'status', 'createdAt']);
      allow read: if isAdmin() || (signedIn() && request.auth.uid == courierId);
      allow update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read, create, update: if signedIn() && request.auth.uid == clientId;
      allow delete: if isAdmin();
    }

    match /gestion/{docId} {
      allow read, write: if isAdmin();
    }

    match /restaurants/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}